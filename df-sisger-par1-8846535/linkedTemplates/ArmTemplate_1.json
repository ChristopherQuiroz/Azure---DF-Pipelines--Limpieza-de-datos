		{
			"name": "[concat(parameters('factoryName'), '/df_calificaciones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "calificaciones_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "calificaciones_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "split1"
						},
						{
							"name": "derivedColumn1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          calificacion_id as string,",
						"          pedido_id as string,",
						"          cliente_id as string,",
						"          fecha_calificacion as string,",
						"          puntuacion as string,",
						"          comentario as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 split(!isNull(calificacion_id) || !isNull(pedido_id) || !isNull(cliente_id) || !isNull(fecha_calificacion) || !isNull(puntuacion) || !isNull(comentario),",
						"     disjoint: false) ~> split1@(validados, rechazados)",
						"split1@validados derive(fecha_calificacion = toDate(fecha_calificacion),",
						"          puntuacion = toInteger(puntuacion)) ~> derivedColumn1",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          calificacion_id as string,",
						"          pedido_id as string,",
						"          cliente_id as string,",
						"          fecha_calificacion as date,",
						"          puntuacion as integer,",
						"          comentario as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		}
